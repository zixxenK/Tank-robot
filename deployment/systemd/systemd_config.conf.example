# Rock64 Ranger — Deployment Configuration
# Copy this file to systemd_config.conf and update values for your setup.
# Generated/managed by deployment/scripts/rock64_setup.sh

# ── Network ────────────────────────────────────────────────────────────────
# IP address of the Rock64 SBC on your local network
ROCK64_IP=192.168.1.139
ROCK64_USE_DISCOVERY_SERVER=0

# ── Hardware ───────────────────────────────────────────────────────────────
# Serial port for STM32 motor controller.
# The udev rule (99-rock64-stm32.rules) creates a stable symlink to the
# Approved custom Hiwonder WCH USB-UART node, wired to USART1 PA9/PA10
# (the product connector is labeled UART1):
#   /dev/rock64_stm32  ->  /dev/ttyACM*  (VID:1A86 PID:55D4)
SERIAL_PORT=/dev/rock64_stm32

# IP address of the ESP32-S3 camera node on station (client) WiFi
CAMERA_IP_STATION=192.168.1.125

# Set to true to launch the ESP32 camera bridge node
USE_CAMERA_BRIDGE=true
USE_COMPRESSED_CAMERA_TRANSPORT=true
CAMERA_JPEG_QUALITY=70

# Launch the direct STL-50B2 driver from normal robot bringup.
USE_LIDAR=false
LIDAR_SERIAL_PORT=/dev/ttyS2
LIDAR_SYNC_GPIOCHIP=/dev/gpiochip2
LIDAR_BAUDRATE=115200
LIDAR_USE_SYNC=true

# Launch the USB webcam bridge. The ESP32 camera remains /camera/image_raw;
# the USB camera is published independently as /camera/usb/image_raw.
USE_USB_CAMERA=true
USB_CAMERA_DEVICE=auto

# The web dashboard is external to this repository. ROS topics can be exposed
# through rosbridge on this separate port to avoid the dashboard HTTPS port.
USE_ROSBRIDGE=false
ROSBRIDGE_PORT=9091

# Set false only for host-side simulation or mocked integration tests.
USE_HARDWARE_BRIDGE=true

# Launch the PS5 DualSense joystick bridge on the normal operator startup.
USE_TELEOP=true
PS5_JOY_DEVICE=/dev/input/ps5_controller

# Launch the PS5-triggered buzzer/song node and /buzzer/frequency transport.
USE_AUDIO=true

# Set to true only if production firmware with active battery telemetry is loaded.
# Defaults to false so motor teleoperation is not blocked by missing ADC readings.
MONITOR_BATTERY=false

# The local PC deployment workflow is the primary source of truth. Set this
# true only when the Rock64 is intentionally allowed to pull from its Git
# origin as a fallback update source.
ROCK64_SELF_UPDATE_ENABLED=false

# ── ROS2 ───────────────────────────────────────────────────────────────────
# Set to: humble or auto (auto mode supports Ubuntu 22.04 only)
ROS_DISTRO=auto

# ROS2 domain ID — all nodes on the same domain can communicate
ROS_DOMAIN_ID=42

# Middleware implementation
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Optional Fast DDS discovery server.  Leave unset for normal multicast LAN
# discovery; enable ROCK64_USE_DISCOVERY_SERVER only when this is intentional.
# ROS_DISCOVERY_SERVER=192.168.1.139:11811

# Robot namespace (useful for multi-robot setups)
ROBOT_NAMESPACE=rock64_1
