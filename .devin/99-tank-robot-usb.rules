# Tank Robot USB Device Rules
# Place in /etc/udev/rules.d/99-tank-robot-usb.rules
# After adding, run: sudo udevadm control --reload-rules && sudo udevadm trigger

# STM32 CH340/CH9102 Serial Adapter
# Vendor: WCH (1a86), Product: CH9102 (55d4)
# Replace SERIAL_NUMBER with actual device serial from lsusb -v
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", ATTRS{serial}=="SERIAL_NUMBER", SYMLINK+="rock64_stm32", MODE="0666"

# Fallback rule without serial number (less reliable with multiple CH340 devices)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", MODE="0666"

# PS5 DualSense Controller (Wired USB)
# Vendor: Sony (054c), Product: DualSense (0ce6)
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", SYMLINK+="ps5_controller"

# ESP32-S3 Native USB-CDC (for flashing)
# Vendor: Espressif (303a), Product: USB-JTAG/Serial (1001)
# Replace SERIAL_NUMBER with actual device serial from lsusb -v
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", ATTRS{serial}=="SERIAL_NUMBER", SYMLINK+="esp32_flash", MODE="0666"

# Fallback ESP32 rule without serial number
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", MODE="0666"

# Alternative ESP32 product ID (some boards use 0002)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="0002", MODE="0666"
