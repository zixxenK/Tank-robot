# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
*.pyc

# ROS2
# Build artifacts belong inside ros2_ws/ only - never at repo root
install/
log/
build/

# ros2_ws build artifacts (allowed here, not root)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# PlatformIO
# Build artifacts belong inside firmware/ only - never at repo root
.pio/

# Firmware PlatformIO artifacts (allowed inside firmware/, not root)
firmware/**/.pio/
firmware/**/*.hex
firmware/**/*.bin
firmware/**/*.elf
firmware/**/*.map

# STM32 CMake build — all named build directories
firmware/stm32_chassis/build/
firmware/stm32_chassis/build-*/
firmware/stm32_chassis/cmake-build-*/

# Archived STM32 firmware tree: keep generated artifacts out of git
firmware/stm32_chassis_backupoldoutdated/

# Host-side toolchain parser test build
firmware/stm32_chassis/tools/build-host/

# micro-ROS build cache (populated by scripts/build_microros.sh)
firmware/stm32_chassis/.cache/

# Optional micro-ROS precompiled libraries (large binaries - managed separately)
firmware/stm32_chassis/micro_ros_lib/libmicroros.a
firmware/stm32_chassis/micro_ros_lib/include/

# Additional build artifacts
*.a
*.lib
*.obj
*.out
*.axf

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment / secrets
.env
*.env.local
deployment/.env

# Logs
*.log

# Local tool binaries
tools/*.exe

# CMake & IDE Metadata
.cmake/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# STM32CubeMX Temp Files
*.bak
*.prev

# Keil MDK-ARM IDE
firmware/stm32_chassis/MDK-ARM/
*.uvguix.*
JLinkLog.txt

# Build Artifacts & Output Directories
Debug/
Release/
*.elf
*.bin
*.hex
*.map
*.o
*.d
*.su
