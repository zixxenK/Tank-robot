# Agent Core Environment Configuration
# Copy this file to .env and configure with your specific settings

# ============================================
# LLM Provider Configuration
# ============================================

# Choose LLM provider: "openai", "anthropic", "ollama", "vllm", or "local"
LLM_PROVIDER=openai

# OpenAI Configuration (for LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration (for LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TEMPERATURE=0.7

# Ollama Configuration (for LLM_PROVIDER=ollama)
# Ollama runs locally - provide endpoint URL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_NUM_CTX=2048

# vLLM Configuration (for LLM_PROVIDER=vllm)
# vLLM runs locally or on network - provide endpoint URL
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=meta-llama/Llama-2-7b-chat-hf
VLLM_MAX_TOKENS=2048

# ============================================
# ROS 2 Configuration
# ============================================

# ROS 2 Distribution (humble, iron, jazzy)
ROS_DISTRO=humble

# ROS Domain ID (must match robot network)
ROS_DOMAIN_ID=0

# RMW Implementation (cyclonedds, fastrtps, connext)
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Workspace paths
HOST_WS_PATH=C:\Projects\Tank-Robot\Tank-robot\host_ws

# ============================================
# Vision Configuration
# ============================================

# Camera topics
CAMERA_IMAGE_TOPIC=/camera/image_raw
CAMERA_INFO_TOPIC=/camera/camera_info

# Vision model configuration
VISION_MODEL_PATH=
VISION_MODEL_TYPE=onnx
VISION_CONFIDENCE_THRESHOLD=0.5

# ============================================
# Debug Configuration
# ============================================

# Enable debug logging
DEBUG=false
DEBUG_LEVEL=INFO

# Log file path
LOG_FILE=agent_core.log

# Enable ROS 2 topic monitoring
ENABLE_TOPIC_MONITORING=true
