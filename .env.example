# Tank Robot local development environment template
#
# This file is documentation/template only. It is not sourced automatically.
# Copy it to .env or export the values in the shell that launches ROS 2. Never
# commit a real LM_API_TOKEN or other credentials.

# ROS 2 Humble is the supported host environment.
ROS_DISTRO=humble
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_LOCALHOST_ONLY=0

# Leave blank to resolve the checkout's canonical host_ws directory. If set,
# use the same canonical host_ws path on the machine running ROS, for example:
# HOST_WS_PATH=/opt/rock64-robot/host_ws
HOST_WS_PATH=

# LM Studio runs on the development PC/WSL side. Use the PC address from the
# Rock64; localhost is valid only when the client and LM Studio share a host.
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=
LM_API_TOKEN=

# Normal hardware defaults. These are also represented in the Rock64 systemd
# template at deployment/systemd/systemd_config.conf.example; that file owns
# persistent robot-service configuration.
SERIAL_PORT=/dev/rock64_stm32
PS5_JOY_DEVICE=/dev/input/ps5_controller
CAMERA_IP_STATION=192.168.1.125
USB_CAMERA_DEVICE=auto
USE_TELEOP=true
USE_CAMERA_BRIDGE=true
USE_USB_CAMERA=true
USE_COMPRESSED_CAMERA_TRANSPORT=true
USE_HARDWARE_BRIDGE=true
USE_AUDIO=true
USE_LIDAR=false
USE_ULTRASONIC=false
MONITOR_BATTERY=false

# Optional Fast DDS discovery-server mode. Keep disabled for normal multicast
# discovery on the robot LAN.
ROCK64_USE_DISCOVERY_SERVER=0
# ROCK64_IP=192.168.1.139
# ROS_DISCOVERY_SERVER=192.168.1.139:11811
